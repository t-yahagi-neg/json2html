{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "table.schema.json",
  "title": "json2html table data",
  "type": "object",
  "required": [
    "columns",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": ["string", "null"],
      "description": "ページと自動メニューの表示名。省略・null・空文字ではページのディレクトリ名を使用します。共通設定には指定できません。"
    },
    "assets": {
      "$ref": "config.schema.json#/$defs/assets"
    },
    "alignment": {
      "$ref": "config.schema.json#/$defs/alignment"
    },
    "column_options": {
      "$ref": "config.schema.json#/$defs/columnOptions"
    },
    "hidden_column_filter": {
      "$ref": "config.schema.json#/$defs/hiddenColumnFilter"
    },
    "show_warnings": {
      "$ref": "config.schema.json#/$defs/showWarnings"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/cell"
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "type",
        "text",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "link"
        },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "color": {
      "type": "object",
      "required": [
        "type",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "color"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "multiline": {
      "type": "object",
      "required": [
        "type",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "multiline"
        },
        "lines": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/link"
              }
            ]
          }
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/color"
        },
        {
          "$ref": "#/$defs/multiline"
        }
      ]
    }
  }
}
